{
  "name": "@vortiqlabs/codebase-indexer",
  "version": "0.1.7",
  "description": "A standalone local-first codebase indexing engine",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "codebase-indexer": "dist/bin/codebase-indexer.js",
    "codebase-indexer-mcp": "dist/bin/codebase-indexer-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/bin",
    "dist/dashboard"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
   "build": "node scripts/build.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@msgpack/msgpack": "^3.1.2",
    "express": "^5.2.1",
    "ignore": "^7.0.5",
    "monaco-editor": "^0.57.0",
    "tar": "^7.5.22",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}